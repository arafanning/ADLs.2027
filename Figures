library(dplyr)
library(lmtest)
library(sandwich)
library(ggplot2)
library(tibble)

# ------------------------------------------------------------
# Robust helper function for HC3 results
# ------------------------------------------------------------

tidy_hc3 <- function(model, model_name) {
  
  hc3 <- lmtest::coeftest(
    model,
    vcov. = sandwich::vcovHC(model, type = "HC3")
  )
  
  # IMPORTANT: convert coeftest object to matrix first
  hc3_df <- as.data.frame(as.matrix(hc3))
  
  # Rename columns safely
  names(hc3_df) <- c(
    "estimate",
    "std_error_hc3",
    "statistic",
    "p.value"
  )
  
  hc3_df %>%
    tibble::rownames_to_column("term") %>%
    dplyr::mutate(model = model_name) %>%
    dplyr::select(
      model,
      term,
      estimate,
      std_error_hc3,
      statistic,
      p.value
    )
}

# ============================================================
# FIGURE 4. Raw adl_total HC3 cannabis effects across steps
# Fixed HC3 helper
# ============================================================

library(dplyr)
library(lmtest)
library(sandwich)
library(ggplot2)
library(tibble)

tidy_hc3 <- function(model, model_name) {
  
  hc3 <- lmtest::coeftest(
    model,
    vcov. = sandwich::vcovHC(model, type = "HC3")
  )
  
  # Force the coeftest object into a plain numeric matrix
  hc3_mat <- unclass(hc3)
  
  # Build dataframe manually by column position
  hc3_df <- tibble::tibble(
    term = rownames(hc3_mat),
    estimate = hc3_mat[, 1],
    std_error_hc3 = hc3_mat[, 2],
    statistic = hc3_mat[, 3],
    p.value = hc3_mat[, 4],
    model = model_name
  ) %>%
    dplyr::select(
      model,
      term,
      estimate,
      std_error_hc3,
      statistic,
      p.value
    )
  
  return(hc3_df)
}

