tidy_polr_with_p <- function(model, model_name) {
  
  tidy_df <- broom::tidy(
    model,
    conf.int = TRUE,
    exponentiate = TRUE
  )
  
  # broom sometimes does not return p-values for polr
  tidy_df %>%
    dplyr::mutate(
      p.value = 2 * pnorm(abs(statistic), lower.tail = FALSE),
      model = model_name
    )
}

