  tidy_polr_with_p(model_now_ord_1_core, "1 Core adjusted"),
  tidy_polr_with_p(model_now_ord_2_demo, "2 Demographic-expanded"),
  tidy_polr_with_p(model_now_ord_3_hiv, "3 HIV-adjusted")
)

current_ord_cannabis_plot_df <- current_ord_results %>%
  dplyr::filter(grepl("du_mar4_12m_aBin_ord", term)) %>%
  dplyr::mutate(
    cannabis_term = dplyr::case_when(
      grepl("\\.L", term) ~ "Linear cannabis contrast",
      grepl("\\.Q", term) ~ "Quadratic cannabis contrast"
    ),
    model = factor(
      model,
      levels = c(
        "0 Cannabis only",
        "1 Core adjusted",
        "2 Demographic-expanded",
        "3 HIV-adjusted"
      ),
      ordered = TRUE
    )
  )

fig13_current_ord_or_steps <- ggplot(
  current_ord_cannabis_plot_df,
  aes(
    x = model,
    y = estimate,
    group = cannabis_term,
    linetype = cannabis_term,
    shape = cannabis_term
  )
) +
  geom_hline(yintercept = 1, linetype = "dashed") +
  geom_point(size = 3) +
  geom_line() +
  geom_errorbar(
    aes(ymin = conf.low, ymax = conf.high),
    width = 0.12
  ) +
  labs(
    title = "Cannabis Effects Across Ordinal Current ADL Burden Model Steps",
    subtitle = "Outcome: no, low, or higher current ADL difficulty",
    x = "Model step",
    y = "Odds ratio",
    linetype = "Cannabis term",
    shape = "Cannabis term"
  ) +
  theme_classic(base_size = 14) +
  theme(
    axis.text.x = element_text(angle = 35, hjust = 1)
  )

fig13_current_ord_or_steps

ggsave(
  filename = "ADL_figures/Figure13_current_ordinal_ADL_burden_cannabis_ORs_steps.png",
  plot = fig13_current_ord_or_steps,
  width = 8,
  height = 5.5,
  dpi = 300
)

